# ==============================================================================
# TASK COMPASS — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env in production and replace placeholder values with secrets.
# NEVER commit the real .env file or production credentials to version control.
# ==============================================================================

# Django Secret Key (Generate a random 50+ character string for production)
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secure-random-secret-key-here-min-50-characters

# Debug Mode: Set to False in production
DJANGO_DEBUG=False

# Allowed Hostnames (Comma-separated list of domain names and IPs)
ALLOWED_HOSTS=taskcompass.example.com,127.0.0.1,localhost

# CSRF Trusted Origins (Comma-separated list of origins with scheme)
CSRF_TRUSTED_ORIGINS=https://taskcompass.example.com

# HTTPS / SSL Security Hardening (Set to True in production with SSL certificates)
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000

# Database URL (Optional: Leave unset for SQLite, or provide a PostgreSQL connection URL)
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Logging Level (INFO, WARNING, ERROR, CRITICAL)
DJANGO_LOG_LEVEL=INFO
